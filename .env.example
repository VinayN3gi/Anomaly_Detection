# ==============================================================================
# Environment Configuration Template (.env.example)
#
# Copy this file to .env and customize as needed.
# DO NOT commit real secrets or production .env to version control.
# ==============================================================================

# Database Configuration (SQLite default; PostgreSQL / TimescaleDB supported)
DATABASE_PATH=data/monitoring.db
DATABASE_URL=sqlite:///data/monitoring.db
# For PostgreSQL / TimescaleDB:
# DATABASE_URL=postgresql://aiops_user:aiops_password@localhost:5432/aiops_monitoring

# Monitoring Engine Configuration
DEFAULT_CHECK_INTERVAL=60
REQUEST_TIMEOUT=10.0
CONNECT_TIMEOUT=5.0
MAX_REDIRECTS=5

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Logging Configuration (console for development, json for Docker/production)
LOG_LEVEL=INFO
LOG_FORMAT=console
