# ==============================================================================
# Environment Configuration Template (.env.example)
#
# Copy this file to .env and populate with appropriate configuration.
# DO NOT commit the .env file to version control.
#
# SECURITY BEST PRACTICE:
# For production environments, prefer AWS IAM Roles, AWS Secrets Manager, or
# instance profiles instead of hardcoded long-lived access keys.
# ==============================================================================

# AWS Configuration (Leave blank if using IAM Role / Instance Profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Flask API Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration (Future Phases)
DATABASE_URL=

